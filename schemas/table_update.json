{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tables.tables.update payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["table_id", "number", "name", "capacity", "zone_id", "shape", "status", "is_active"],
  "properties": {
    "table_id": {
      "type": "string",
      "minLength": 1,
      "description": "UUID de la mesa a actualizar"
    },
    "number": {
      "type": "string",
      "minLength": 1,
      "description": "Número/código visible de la mesa"
    },
    "name": {
      "type": "string",
      "description": "Nombre descriptivo de la mesa (puede ser vacío)"
    },
    "capacity": {
      "type": "integer",
      "minimum": 1,
      "description": "Aforo de la mesa (`capacity <= 0` → invalid_capacity)"
    },
    "zone_id": {
      "type": ["string", "null"],
      "description": "UUID de la zona contenedora (null = mesa sin zona)"
    },
    "shape": {
      "type": "string",
      "enum": ["square", "round", "rectangle"],
      "description": "Forma de la mesa"
    },
    "status": {
      "type": "string",
      "enum": ["available", "occupied", "reserved", "blocked"],
      "description": "Estado de la mesa (fuera del enum → invalid_status)"
    },
    "is_active": {
      "type": ["boolean", "integer"],
      "description": "Mesa activa en el plano (booleano o 0/1)"
    }
  }
}
